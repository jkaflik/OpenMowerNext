      "message": "{\n  \"header\": {\n    \"frame_id\": \"base_link\"\n  },\n  \"twist\": {\n    \"linear\": { \"x\": 0, \"y\": 0, \"z\": 0 },\n    \"angular\": { \"x\": 0, \"y\": 0, \"z\": 0 }\n  }\n}",
      "buttonTitle": "Publish stop",
      "buttonText": "Publish stop",
      "buttonTooltip": "Publish zero TwistStamped to /cmd_vel_joy",
      "buttonColor": "#dc2626",
      "editingMode": false,
